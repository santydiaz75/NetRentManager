@page "/properties/{id}"
@rendermode InteractiveServer

<PageTitle>Detalle de propiedad</PageTitle>

<div class="page-container">
    <header class="page-header">
        <div>
            <h1 class="page-title">Detalle de propiedad</h1>
            <p class="page-subtitle">Información pública de la propiedad seleccionada.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-secondary" href="/">Volver al listado</a>
        </div>
    </header>

    @if (IsLoading)
    {
        <div class="state-loading" role="status">Cargando propiedad...</div>
    }
    else if (HasNotFound)
    {
        <div class="state-empty" role="status">
            <h2>Propiedad no encontrada</h2>
            <p>No existe una propiedad asociada al identificador solicitado.</p>
        </div>
    }
    else if (HasError)
    {
        <div class="state-error" role="alert">
            <h2>No se pudo cargar la propiedad</h2>
            <p>Intenta nuevamente más tarde.</p>
        </div>
    }
    else if (Property is not null)
    {
        <article class="card property-detail" aria-labelledby="property-title">
            <div class="property-detail-media">
                @if (!string.IsNullOrWhiteSpace(Property.ImageUrl))
                {
                    <img src="@Property.ImageUrl" alt="@Property.Title" class="property-detail-image" />
                }
                else
                {
                    <div class="property-detail-placeholder" role="img" aria-label="Imagen no disponible">
                        <LucideIcon Name="image-off" Class="icon icon-lg icon-muted" />
                        <span>Imagen no disponible</span>
                    </div>
                }
            </div>

            <div class="card-body property-detail-body">
                <div>
                    <h2 id="property-title" class="page-title">@Property.Title</h2>
                    <p class="page-subtitle">@Property.Address</p>
                </div>

                <div class="property-detail-topline">
                    <span class="badge @StatusBadgeClass">@Property.Status</span>
                    <span class="property-detail-price">@Property.Price.ToString("C")</span>
                </div>

                <p class="property-detail-description">@Property.Description</p>

                <dl class="property-detail-metrics">
                    <div>
                        <dt>Identificador</dt>
                        <dd>@Property.Id</dd>
                    </div>
                    <div>
                        <dt>Dormitorios</dt>
                        <dd>@Property.BedroomCount</dd>
                    </div>
                    <div>
                        <dt>Baños</dt>
                        <dd>@Property.BathroomCount</dd>
                    </div>
                    <div>
                        <dt>Superficie</dt>
                        <dd>@Property.AreaSquareMeters m²</dd>
                    </div>
                    <div>
                        <dt>Dirección</dt>
                        <dd>@Property.Address</dd>
                    </div>
                </dl>
            </div>
        </article>
    }
</div>
