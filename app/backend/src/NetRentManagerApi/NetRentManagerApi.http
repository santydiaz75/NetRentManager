PUT {{NetRentManagerApi_HostAddress}}/api/properties/{{PropertyId}}
Content-Type: multipart/form-data; boundary=UpdatePropertyImageBoundary

--UpdatePropertyImageBoundary
Content-Disposition: form-data; name="title"

Apartamento con imagen actualizada
--UpdatePropertyImageBoundary
Content-Disposition: form-data; name="description"

Descripción actualizada con imagen
--UpdatePropertyImageBoundary
Content-Disposition: form-data; name="address"

Calle Principal 11
--UpdatePropertyImageBoundary
Content-Disposition: form-data; name="price"

1300
--UpdatePropertyImageBoundary
Content-Disposition: form-data; name="status"

Available
--UpdatePropertyImageBoundary
Content-Disposition: form-data; name="bedroomCount"

2
--UpdatePropertyImageBoundary
Content-Disposition: form-data; name="bathroomCount"

2
--UpdatePropertyImageBoundary
Content-Disposition: form-data; name="areaSquareMeters"

80
--UpdatePropertyImageBoundary
Content-Disposition: form-data; name="image"; filename="property.png"
Content-Type: image/png

< .\support\seed-data\images\properties\1.png
