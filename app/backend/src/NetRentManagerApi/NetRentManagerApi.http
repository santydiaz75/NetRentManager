@NetRentManagerApi_HostAddress = http://localhost:5065

POST {{NetRentManagerApi_HostAddress}}/api/properties
Content-Type: multipart/form-data; boundary=CreatePropertyBoundary

--CreatePropertyBoundary
Content-Disposition: form-data; name="title"

Apartamento nuevo
--CreatePropertyBoundary
Content-Disposition: form-data; name="description"

Descripción de prueba
--CreatePropertyBoundary
Content-Disposition: form-data; name="address"

Calle Principal 10
--CreatePropertyBoundary
Content-Disposition: form-data; name="price"

1200
--CreatePropertyBoundary
Content-Disposition: form-data; name="status"

Available
--CreatePropertyBoundary
Content-Disposition: form-data; name="bedroomCount"

2
--CreatePropertyBoundary
Content-Disposition: form-data; name="bathroomCount"

1
--CreatePropertyBoundary
Content-Disposition: form-data; name="areaSquareMeters"

70
--CreatePropertyBoundary--
Accept: application/json

###

@PropertyWithImageId = 00000000-0000-0000-0000-000000000001
@PropertyWithoutImageId = 00000000-0000-0000-0000-000000000002

GET {{NetRentManagerApi_HostAddress}}/api/properties/{{PropertyWithImageId}}
Accept: application/json

###

GET {{NetRentManagerApi_HostAddress}}/api/properties/{{PropertyWithoutImageId}}
Accept: application/json

###

GET {{NetRentManagerApi_HostAddress}}/api/properties/00000000-0000-0000-0000-000000000099
